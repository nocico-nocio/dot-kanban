{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dot-kanban",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dot-kanban",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "REPLACE_WITH_OAUTH_KV_ID" }],
  "containers": [
    { "class_name": "SenderContainer", "image": "./sender/Dockerfile", "max_instances": 1 }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SENDER_CONTAINER", "class_name": "SenderContainer" }]
  },
  "exports": { "SenderContainer": { "type": "durable-object", "storage": "sqlite" } },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "EVENTS_ENABLED": "true" },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
